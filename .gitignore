# --- Secrets & Config (CRITICAL - never commit these) ---
.env
.env.local
*.env
config.json
secrets.json
local.settings.json
connection_strings.txt
*.pem
*.key
test.py
tempCodeRunnerFile.py
# throwaway script with hardcoded SQL password, never meant to be committed

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
# tfstate can contain resource IDs/sensitive data, tfvars often holds real secrets
# .terraform/ holds downloaded provider binaries, huge, regenerable via init
# NOTE: keep .terraform.lock.hcl tracked, NOT ignored - ensures consistent provider versions

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/

# --- Jupyter Notebooks (if you prototype in these) ---
.ipynb_checkpoints/

# --- Azure Functions (if you use Functions locally) ---
local.settings.json
.azure/
bin/
obj/

# --- QGIS ---
*.qgz~
*.qgs~
.qgis-lock
*_qgd
# Keep the actual boundary GeoJSON export, ignore QGIS project temp/lock files only

# --- Logs & Data dumps ---
*.log
logs/
*.csv
!sample_data.csv
# (unignore a specific sample file if you want one committed for demo purposes)

# --- OS-specific junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE ---
.vscode/
.idea/
*.swp

# --- Misc ---
*.bak
*.tmp